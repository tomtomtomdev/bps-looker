{
  "openapi": "3.1.0",
  "info": {
    "title": "BPS looker read API",
    "description": "Read-only access to the crawled BPS data (labeled `v_*` views).",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness + database reachability",
        "description": "200 with the DB's Alembic revision, or 503 when the database can't be reached.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/domains": {
      "get": {
        "tags": [
          "domains"
        ],
        "summary": "BPS domains (national, provinces, regencies)",
        "description": "Every crawled domain, ordered by ``domain_id``; ``level`` filters pusat/prov/kab.",
        "operationId": "listDomains",
        "parameters": [
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pusat",
                    "prov",
                    "kab"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only domains at this level.",
              "title": "Level"
            },
            "description": "Only domains at this level."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Domain"
                  },
                  "title": "Response Listdomains"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/variables": {
      "get": {
        "tags": [
          "variables"
        ],
        "summary": "Search the dynamic-table variable catalog",
        "description": "Full-text search ranked by relevance (title over subject), or all by title when ``q`` is\nempty; ``total`` counts every match.",
        "operationId": "searchVariables",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words to find in the title or subject (all must match, each as a prefix: `infl bul`). Empty → every variable, by title.",
              "title": "Q"
            },
            "description": "Words to find in the title or subject (all must match, each as a prefix: `infl bul`). Empty → every variable, by title."
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this domain (e.g. `0000`).",
              "title": "Domain"
            },
            "description": "Only this domain (e.g. `0000`)."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pusat",
                    "prov",
                    "kab"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only domains at this level.",
              "title": "Level"
            },
            "description": "Only domains at this level."
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this subject (`subject_id`).",
              "title": "Subject"
            },
            "description": "Only this subject (`subject_id`)."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based page number.",
              "default": 1,
              "title": "Page"
            },
            "description": "1-based page number."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VariablePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/variables/{domain}/{var}": {
      "get": {
        "tags": [
          "variables"
        ],
        "summary": "A variable's metadata and dimensions",
        "description": "Title, unit, subject, definition/notes (BPS HTML — sanitize before rendering), decimals,\nlast update, plus every dimension member: vervar (regions/categories), turvar, turth\n(sub-periods with their ``freq`` and ``has_data``) and periods (``th`` = year).",
        "operationId": "getVariable",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "description": "Domain id, e.g. `0000`.",
              "title": "Domain"
            },
            "description": "Domain id, e.g. `0000`."
          },
          {
            "name": "var",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Variable id within the domain.",
              "title": "Var"
            },
            "description": "Variable id within the domain."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VariableDetail"
                }
              }
            }
          },
          "404": {
            "description": "Unknown variable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/variables/{domain}/{var}/series": {
      "get": {
        "tags": [
          "variables"
        ],
        "summary": "Time series of a variable, one per vervar x turvar",
        "description": "One series per vervar x turvar combination (request order), at most ``max_series``\n(``truncated`` when more were asked for); points sorted by time, each with its period\n(``2024-03``, ``2024-Q2``, ``2024-S1``, ``2024``) and start date.",
        "operationId": "getVariableSeries",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "description": "Domain id, e.g. `0000`.",
              "title": "Domain"
            },
            "description": "Domain id, e.g. `0000`."
          },
          {
            "name": "var",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Variable id within the domain.",
              "title": "Var"
            },
            "description": "Variable id within the domain."
          },
          {
            "name": "vervar",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Vervar members (repeat the parameter); default: all.",
              "title": "Vervar"
            },
            "description": "Vervar members (repeat the parameter); default: all."
          },
          {
            "name": "turvar",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Turvar members (repeat the parameter); default: all.",
              "title": "Turvar"
            },
            "description": "Turvar members (repeat the parameter); default: all."
          },
          {
            "name": "turth",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only these sub-periods, e.g. months `1`-`12`; default: all.",
              "title": "Turth"
            },
            "description": "Only these sub-periods, e.g. months `1`-`12`; default: all."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown variable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/variables/{domain}/{var}/cross-section": {
      "get": {
        "tags": [
          "variables"
        ],
        "summary": "One value per region for one period (ranking + map)",
        "description": "Every vervar member's value for one (``th``, ``turth``) period — by default the latest\nwith data (for ``turvar`` and ``freq``) — sorted by value, highest first (members without a\nvalue last, ``null``). The national aggregate (9999 / ``INDONESIA``) comes as ``national``,\nnot ranked. ``periods`` lists every period with data, in time order, for a slider.",
        "operationId": "getVariableCrossSection",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "description": "Domain id, e.g. `0000`.",
              "title": "Domain"
            },
            "description": "Domain id, e.g. `0000`."
          },
          {
            "name": "var",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Variable id within the domain.",
              "title": "Var"
            },
            "description": "Variable id within the domain."
          },
          {
            "name": "th",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Year (`th`); default: the latest.",
              "title": "Th"
            },
            "description": "Year (`th`); default: the latest."
          },
          {
            "name": "turvar",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Turvar member; default: the first.",
              "title": "Turvar"
            },
            "description": "Turvar member; default: the first."
          },
          {
            "name": "turth",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sub-period; default: the latest of the year.",
              "title": "Turth"
            },
            "description": "Sub-period; default: the latest of the year."
          },
          {
            "name": "freq",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "month",
                    "quarter",
                    "semester",
                    "year",
                    "other"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only periods of this kind (slider + default).",
              "title": "Freq"
            },
            "description": "Only periods of this kind (slider + default)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrossSection"
                }
              }
            }
          },
          "404": {
            "description": "Unknown variable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/indicators": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "Latest strategic indicators of a domain, with change vs the previous periode",
        "description": "Every indicator's latest snapshot (``v_indicator_latest``) plus the previous periode's\nvalue and the change (``null`` when unknown); ``variable`` links to the Explorer when the\nunderlying variable is crawled. A known domain without indicators → empty ``items``.",
        "operationId": "listIndicators",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "description": "National `0000` (default) or a province domain.",
              "default": "0000",
              "title": "Domain"
            },
            "description": "National `0000` (default) or a province domain."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorList"
                }
              }
            }
          },
          "404": {
            "description": "Unknown domain"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/indicators/{domain}/{indicator_id}/history": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "Every recorded periode of one strategic indicator",
        "description": "The latest snapshot (as in ``GET /indicators``) plus one point per periode seen by the\ncrawler, oldest first (sighting order: ``periode`` is free text).",
        "operationId": "getIndicatorHistory",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "description": "Domain id, e.g. `0000`.",
              "title": "Domain"
            },
            "description": "Domain id, e.g. `0000`."
          },
          {
            "name": "indicator_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "BPS indicator id within the domain.",
              "title": "Indicator Id"
            },
            "description": "BPS indicator id within the domain."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorHistory"
                }
              }
            }
          },
          "404": {
            "description": "Unknown indicator"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CrossSection": {
        "properties": {
          "turvar": {
            "anyOf": [
              {
                "type": "integer"
              },
