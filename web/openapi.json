              {
                "type": "null"
              }
            ]
          },
          "periods": {
            "items": {
              "$ref": "#/components/schemas/CrossSectionPeriod"
            },
            "type": "array",
            "title": "Periods"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/CrossSectionRegion"
            },
            "type": "array",
            "title": "Regions"
          },
          "national": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CrossSectionRegion"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "turvar",
          "turvar_label",
          "period",
          "periods",
          "regions",
          "national"
        ],
        "title": "CrossSection",
        "description": "Every vervar member's value for one period: ranking + map."
      },
      "CrossSectionPeriod": {
        "properties": {
          "th": {
            "type": "integer",
            "title": "Th"
          },
