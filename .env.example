# BPS WebAPI credentials — copy to .env and fill in
BPS_API_KEY=
# Optional (defaults shown)
# DATABASE_URL=postgresql+psycopg://bps:bps@localhost:5432/bps
# BPS_CONCURRENCY=4
# BPS_RPS=2.0
# BPS_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) bps-looker

# Docker compose only (defaults shown). DATABASE_URL is set by compose to the `db` service.
# Keep POSTGRES_PASSWORD URL-safe (letters/digits) — it is interpolated into DATABASE_URL.
# POSTGRES_USER=bps
# POSTGRES_PASSWORD=bps
# POSTGRES_DB=bps
# POSTGRES_PORT=5432
# Seconds between scheduler runs (refresh + drain + status):
# BPS_SCHEDULE_INTERVAL=3600
# Scheduler's `bps work --drain-wait`:
# BPS_DRAIN_WAIT=300
# Scheduler logs an ALERT when dead tasks exceed this:
# BPS_MAX_DEAD=0
# 0 = the container entrypoint skips migrating the DB before running the command:
# BPS_MIGRATE_ON_START=1
